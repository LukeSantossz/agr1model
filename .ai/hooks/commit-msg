#!/bin/bash
# Hook: commit-msg
# Validates commit message format according to Conventional Commits
# Rule: 09-enforcement.md section 9.1

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Valid commit types
TYPES="feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert"

# Pattern: type(scope): subject OR type: subject
PATTERN="^($TYPES)(\([a-zA-Z0-9_-]+\))?: .{10,100}$"

# Check if message matches pattern
if ! echo "$COMMIT_MSG" | head -1 | grep -Eq "$PATTERN"; then
    echo "ERROR: Commit message does not follow Conventional Commits format."
    echo ""
    echo "Expected format: type(scope): subject"
    echo "  - type: $TYPES"
    echo "  - scope: optional, in parentheses"
    echo "  - subject: 10-100 characters, imperative mood"
    echo ""
    echo "Examples:"
    echo "  feat(auth): add Google OAuth integration"
    echo "  fix(api): handle 500 error on user endpoint"
    echo "  docs: update README with setup instructions"
    echo ""
    echo "Your message: $COMMIT_MSG"
    exit 1
fi

# Check for body/footer (should only have one line)
LINE_COUNT=$(wc -l < "$COMMIT_MSG_FILE" | tr -d ' ')
if [ "$LINE_COUNT" -gt 1 ]; then
    # Allow empty lines but no actual content after first line
    CONTENT_LINES=$(grep -v "^$" "$COMMIT_MSG_FILE" | wc -l | tr -d ' ')
    if [ "$CONTENT_LINES" -gt 1 ]; then
        echo "ERROR: Commit message should not have body or footer."
        echo "Keep the message in a single line. If it doesn't fit, the change is too big."
        exit 1
    fi
fi

# Check for co-authorship trailers
if grep -Eiq "^(Co-authored-by|Signed-off-by):" "$COMMIT_MSG_FILE"; then
    echo "ERROR: Co-authorship trailers are not allowed."
    echo "Remove any Co-authored-by or Signed-off-by lines."
    exit 1
fi

exit 0
