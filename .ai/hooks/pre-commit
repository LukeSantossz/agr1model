#!/bin/bash
# Hook: pre-commit
# Detects debug statements in staged files
# Rule: 09-enforcement.md section 9.1

# Load patterns from enforcement.conf if exists
CONF_FILE=".ai/enforcement.conf"
if [ -f "$CONF_FILE" ]; then
    source "$CONF_FILE"
else
    # Default patterns by file extension
    JS_PATTERNS="console\.(log|debug|info|warn|error)|debugger"
    PY_PATTERNS="print\(|breakpoint\(\)|pdb\.set_trace\(\)"
    JAVA_PATTERNS="System\.out\.print"
fi

HAS_ERROR=0

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
    # Skip if file doesn't exist
    [ ! -f "$FILE" ] && continue

    # Get file extension
    EXT="${FILE##*.}"

    # Select patterns based on extension
    case "$EXT" in
        js|ts|jsx|tsx|mjs)
            PATTERNS="$JS_PATTERNS"
            ;;
        py)
            PATTERNS="$PY_PATTERNS"
            ;;
        java)
            PATTERNS="$JAVA_PATTERNS"
            ;;
        *)
            # Skip files with unknown extensions
            continue
            ;;
    esac

    # Check for debug statements in staged content
    MATCHES=$(git diff --cached "$FILE" | grep -E "^\+" | grep -E "$PATTERNS" || true)

    if [ -n "$MATCHES" ]; then
        echo "WARNING: Debug statement found in $FILE"
        echo "$MATCHES"
        echo ""
        HAS_ERROR=1
    fi
done

if [ $HAS_ERROR -eq 1 ]; then
    echo "---"
    echo "Debug statements detected. Remove them before committing."
    echo "Use --no-verify to bypass (document the reason in next session)."
    exit 1
fi

exit 0
